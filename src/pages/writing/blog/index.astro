---
import { getCollection } from "astro:content";

import Writing from "../../../layouts/Writing.astro";
import { formatDate } from "../../../lib/dates.mjs";
import { isPublished } from "../../../lib/drafts.mjs";

const DESCRIPTION =
  "Essays on software, fiction, and whatever else holds still long enough.";

// The category filter chips are a React island and arrive in phase 4. Until then
// this lists every published post, which is what the chips' "All" state shows.
const showDrafts = import.meta.env.DEV;
const posts = (await getCollection("blog", ({ data }) => isPublished(data, showDrafts))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Writing title="Essays" description={DESCRIPTION}>
  <div class="page">
    <h1 class="page__title">Essays</h1>

    {
      posts.length === 0 ? (
        <p class="empty">Nothing here yet.</p>
      ) : (
        <div class="list">
          {posts.map((post) => (
            <a class="card entry" href={`/writing/blog/${post.id}`}>
              {showDrafts && post.data.draft && <span class="draft-badge">DRAFT</span>}
              <time class="meta" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <h2 class="card__title">{post.data.title}</h2>
              <p class="card__excerpt">{post.data.excerpt}</p>
              {post.data.tags.length > 0 && (
                <div class="tags entry__tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      )
    }
  </div>
</Writing>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .entry {
    padding: 1.5rem;
  }

  .entry__tags {
    margin-top: 0.75rem;
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
