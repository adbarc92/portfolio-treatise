---
// The shared shell for every /writing/* page: document head, the contents nav,
// and the essays' stylesheet.
//
// The head is the load-bearing part. Every tag here already exists on the live
// pages and has been indexed, unfurled, or subscribed to, so this is a
// reproduction rather than a design — parity is verified by diffing the built
// <head> against the live one, not by reading it.
//
// The gear background is deliberately absent. It is being redesigned rather than
// ported, and arrives as its own phase.
import "../styles/foundation.css";
import "../styles/writing.css";
import ContentsNav from "../components/ContentsNav.astro";
import { SITE, absoluteUrl, canonicalPath, pageTitle } from "../lib/site.mjs";

interface Props {
  title?: string;
  description: string;
  /** 'article' for a post, a spec document, or a project; 'website' otherwise. */
  ogType?: "website" | "article";
}

const { title, description, ogType = "website" } = Astro.props;

const fullTitle = pageTitle(title);
const canonical = absoluteUrl(canonicalPath(Astro.url.pathname));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-opsz-italic.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(SITE.image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={absoluteUrl(SITE.feed)}
    />
  </head>
  <body>
    <div class="page">
      <ContentsNav />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
