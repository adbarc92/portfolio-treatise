---
// The projects index, rendered from claims.yaml's `catalogue:` — the same source
// the root's III. Catalogue renders. It was a separate Astro content collection
// under content/projects/, which meant the site held two disjoint answers to
// "what has he built": four projects on the root, two different ones here, and
// no link between them. One source, one answer.
//
// §2.12: a sequence of `article.entry` separated by hairline top rules, never a
// grid. It was a card grid of `.card`, `.tag` and `.grid`, none of which had a
// CSS rule anywhere; the classes used here are ones foundation.css defines.
import Writing from "../../../layouts/Writing.astro";
import { claims } from "../../../lib/claims";
import { formatDate } from "../../../lib/dates.mjs";
import { DESCRIPTIONS } from "../../../lib/site.mjs";

const entries = [...claims.catalogue].sort(
  (a, b) => new Date(String(b.date)).valueOf() - new Date(String(a.date)).valueOf(),
);
---

<Writing title="Projects" description={DESCRIPTIONS.projects}>
  <div class="page">
    <a class="back-link" href="/writing/">&larr; All writing</a>

    <p class="section-label smallcaps">Projects</p>

    {
      entries.length === 0 ? (
        <p class="empty">No projects yet.</p>
      ) : (
        entries.map((c) => (
          <article class="entry">
            <div class="entry-head">
              <h3>
                <a href={`/writing/projects/${c.id}`}>{c.name}</a>
              </h3>
              {c.tags.length > 0 && <p class="entry-meta">{c.tags.join(" · ")}</p>}
            </div>

            <div class="body-grid">
              <div class="prose">
                <p class="abstract">{c.blurb}</p>
              </div>
              <aside class="margin-note">
                {formatDate(new Date(String(c.date)))}
                <br />
                {c.source === "closed" ? "source closed" : "source open"}
              </aside>
            </div>
          </article>
        ))
      )
    }
  </div>
</Writing>

<style>
  /* Matches `.writing-index .abstract`, which styles the same paragraph on the
     hub. The hub reaches it through its own wrapper class, so this page cannot
     borrow that rule and states it instead. */
  .abstract {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--bone-muted);
  }

  .entry-head h3 a {
    text-decoration-color: transparent;
  }

  .entry-head h3 a:hover {
    text-decoration-color: var(--oxblood);
  }
</style>
