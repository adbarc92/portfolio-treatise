---
// The shared shell for every /writing/* page: document head, the fixed nav bar,
// and the essays' stylesheet.
//
// The gear background is deliberately absent — it is a React island and arrives
// in phase 4 along with the category filter. Open Graph, Twitter, and feed tags
// are likewise phase 5; this phase emits title, description, and canonical only.
import "../styles/writing.css";

interface Props {
  title?: string;
  description: string;
  /** The landing page hides the bar, as the React site did at `/`. */
  showNav?: boolean;
}

const { title, description, showNav = true } = Astro.props;

const SITE_TITLE = "Alex Barclay";
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;

// Astro.site is set in astro.config.mjs; the prefix comes from this file living
// under src/pages/writing/, not from a base path.
const canonical = new URL(Astro.url.pathname, Astro.site);

const links = [
  { href: "/writing/blog", label: "Essays" },
  { href: "/writing/eidos", label: "Eidos" },
  { href: "/writing/projects", label: "Projects" },
  { href: "/writing/about", label: "About" },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    {
      showNav && (
        <nav class="writing-nav">
          <a href="/writing/" class="writing-nav__home">
            Alex Barclay
          </a>
          <div class="writing-nav__links">
            {links.map(({ href, label }) => (
              <a
                href={href}
                class="writing-nav__link"
                aria-current={path.startsWith(href) ? "page" : undefined}
              >
                {label}
              </a>
            ))}
          </div>
        </nav>
      )
    }
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .writing-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: rgba(15, 17, 23, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-gear-stroke);
  }

  .writing-nav__home {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .writing-nav__links {
    display: flex;
    gap: 1.5rem;
  }

  .writing-nav__link {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  /* The React bar highlighted by pathname prefix; aria-current carries the same
     state here, so the active style and the accessible one cannot drift apart. */
  .writing-nav__link[aria-current="page"] {
    color: var(--color-accent);
  }

  main {
    position: relative;
    z-index: 1;
  }
</style>
