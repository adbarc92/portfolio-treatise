---
// §2.12: an index is a sequence of entries separated by hairline top rules —
// never cards, never a grid. This page was a `.card` list styled against
// `--color-*` and `--font-mono`, none of which are defined anywhere; the real
// tokens are `--bone-muted`, `--oxblood` and `--mono`. Specifications render as
// `.essay`, which is what WritingIndex.astro already does for them on the hub.
import { getCollection } from "astro:content";

import Writing from "../../../layouts/Writing.astro";
import { DESCRIPTIONS } from "../../../lib/site.mjs";

const docs = (await getCollection("eidos")).sort((a, b) => a.data.order - b.data.order);
const version = docs[0]?.data.version;
---

<Writing title="Eidos" description={DESCRIPTIONS.eidos}>
  <div class="page">
    <a class="back-link" href="/writing/">&larr; All writing</a>

    <p class="section-label smallcaps">
      Eidos{version && <span class="version">v{version}</span>}
    </p>

    <div class="body-grid">
      <div class="prose">
        <p>
          An architecture for cheap code: humans design the Forms, agents fill them, and
          fitness functions verify the fit. The argument is in{" "}
          <a href="/writing/eidos-an-architecture-for-cheap-code">the essay</a>; the
          specification is below.
        </p>
      </div>
    </div>

    {
      docs.map((doc, i) => (
        <div class="essay">
          <div class="body-grid">
            <div class="prose">
              <h3>
                <a href={`/writing/eidos/${doc.id}`}>{doc.data.title}</a>
              </h3>
              <p class="abstract">{doc.data.summary}</p>
            </div>
            <aside class="margin-note">{String(i + 1).padStart(2, "0")} of {docs.length}</aside>
          </div>
        </div>
      ))
    }
  </div>
</Writing>

<style>
  /* §6 rejects fills and radii, so the version is a mono note beside the label
     rather than the pill it was. */
  .version {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0;
    color: var(--bone-muted);
    margin-left: 0.75rem;
  }
</style>
