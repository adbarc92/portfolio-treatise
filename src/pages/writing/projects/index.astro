---
// §2.12: an index is a sequence of `article.entry` separated by hairline top
// rules — never cards, never a grid. This page was a card grid of `.card`,
// `.tag` and `.grid`, none of which had a single CSS rule anywhere, so eight
// tags on one entry overflowed and clipped mid-word. The classes used here are
// the ones foundation.css actually defines.
import { getCollection } from "astro:content";

import Writing from "../../../layouts/Writing.astro";
import { formatDate } from "../../../lib/dates.mjs";
import { DESCRIPTIONS } from "../../../lib/site.mjs";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Writing title="Projects" description={DESCRIPTIONS.projects}>
  <div class="page">
    <a class="back-link" href="/writing/">&larr; All writing</a>

    <p class="section-label smallcaps">Projects</p>

    {
      projects.length === 0 ? (
        <p class="empty">No projects yet.</p>
      ) : (
        projects.map((project) => (
          <article class="entry">
            <div class="entry-head">
              <h3>
                <a href={`/writing/projects/${project.id}`}>{project.data.title}</a>
              </h3>
              {/* §2.6's mono meta line. The tech list lives here rather than in
                  pills: `.entry-head` wraps, so a long list reflows instead of
                  overflowing the way the old tag row did. */}
              {project.data.tags.length > 0 && (
                <p class="entry-meta">{project.data.tags.join(" · ")}</p>
              )}
            </div>

            <div class="body-grid">
              <div class="prose">
                <p class="abstract">{project.data.description}</p>
              </div>
              <aside class="margin-note">Project · {formatDate(project.data.date)}</aside>
            </div>
          </article>
        ))
      )
    }
  </div>
</Writing>

<style>
  /* Matches `.writing-index .abstract`, which styles the same paragraph on the
     hub. The hub reaches it through its own wrapper class, so this page cannot
     borrow that rule and states it instead. */
  .abstract {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--bone-muted);
  }

  .entry-head h3 a {
    text-decoration-color: transparent;
  }

  .entry-head h3 a:hover {
    text-decoration-color: var(--oxblood);
  }
</style>
