---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

import Writing from "../../../layouts/Writing.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);
const { links } = project.data;
---

<Writing title={project.data.title} description={project.data.description} ogType="article">
  <div class="page">
    <a class="back-link" href="/writing/projects">&larr; Back to Projects</a>

    <h1>{project.data.title}</h1>
    <p class="description">{project.data.description}</p>

    {/* Was `.tags`/`.tag`, neither of which had any CSS. The mono meta line of
        §2.6 is the defined form, and it wraps. */}
    {project.data.tags.length > 0 && <p class="entry-meta">{project.data.tags.join(" · ")}</p>}

    {
      links && (
        <div class="links">
          {links.github && (
            <a href={links.github} target="_blank" rel="noopener noreferrer">
              GitHub &rarr;
            </a>
          )}
          {links.live && (
            <a href={links.live} target="_blank" rel="noopener noreferrer">
              Live Demo &rarr;
            </a>
          )}
          {links.itch && (
            <a href={links.itch} target="_blank" rel="noopener noreferrer">
              View on itch.io &rarr;
            </a>
          )}
        </div>
      )
    }

    <article class="prose">
      <Content />
    </article>
  </div>
</Writing>

<style>
  h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  /* foundation.css styles `.entry-head .entry-meta` — a descendant selector.
     This page has no `.entry-head` (it is a document, not an index row), so the
     mono meta line of Â§2.6 is restated here rather than inherited. */
  .entry-meta {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--bone-muted);
    margin-bottom: 1rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }
</style>
