---
import { getEntry, render } from "astro:content";

import Writing from "../../layouts/Writing.astro";
import { SITE } from "../../lib/site.mjs";


const about = await getEntry("about", "about");
if (!about) throw new Error("content/about.md is missing — /writing/about cannot be built");

const { Content } = await render(about);
---

<Writing title="About" description={SITE.description}>
  <div class="page">
    <article class="prose">
      <Content />
    </article>
  </div>
</Writing>
