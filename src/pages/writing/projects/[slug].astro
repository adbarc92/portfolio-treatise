---
// A catalogue entry's own page. Rendered from claims.yaml, like the root's
// III. Catalogue and the index beside it — content/projects/ is gone, and with
// it the second, disagreeing list of projects.
//
// The URLs these emit are frozen: /writing/projects/hexy and
// /writing/projects/portfolio-site carry canonical tags and are linked from
// outside. The ids in claims.yaml are chosen to reproduce them exactly.
import type { GetStaticPaths } from "astro";

import Writing from "../../../layouts/Writing.astro";
import { claims } from "../../../lib/claims";
import { formatDate } from "../../../lib/dates.mjs";

export const getStaticPaths: GetStaticPaths = () =>
  claims.catalogue.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));

const { entry } = Astro.props;
---

<Writing title={entry.name} description={entry.blurb} ogType="article">
  <div class="page">
    <a class="back-link" href="/writing/projects">&larr; Back to Projects</a>

    <h1>{entry.name}</h1>
    <p class="description">{entry.blurb}</p>

    <p class="entry-meta">{entry.meta_line}</p>

    <div class="body-grid">
      <div class="prose">
        <p>{entry.prose.trimEnd()}</p>

        {
          entry.not_yet.length > 0 && (
            <p class="not-yet">{entry.not_yet.join(" ")}</p>
          )
        }

        <p class="links">
          <a href={entry.href} target="_blank" rel="noopener noreferrer">
            {entry.href_label} &rarr;
          </a>
        </p>
      </div>

      <aside class="margin-note">
        {
          entry.claims.map((c) => (
            <>
              <span class="cite-mark">&#8627;</span> {c.text} &mdash;<br />
              {c.verified && (
                <>
                  <span class="verified">&#10003; verified</span> &mdash;<br />
                </>
              )}
              <a href={c.evidence.url}>{c.evidence.label}</a>
              <br />
              <br />
            </>
          ))
        }
        <span class="faint">{entry.source === "closed" ? "SOURCE CLOSED" : "SOURCE OPEN"}</span>
        <br />
        {formatDate(new Date(String(entry.date)))}
        <br />
        <br />
        {entry.tags.join(" · ")}
      </aside>
    </div>
  </div>
</Writing>

<style>
  h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1rem;
    color: var(--bone-muted);
    margin-bottom: 1rem;
  }

  /* foundation.css styles `.entry-head .entry-meta` — a descendant selector.
     This page has no `.entry-head`, so the mono meta line of §2.6 is restated
     here rather than inherited. */
  .entry-meta {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--bone-muted);
    margin-bottom: 2rem;
  }

  .not-yet {
    margin-top: 1rem;
    color: var(--bone-muted);
  }

  .links {
    margin-top: 2rem;
    font-size: 0.85rem;
  }
</style>
