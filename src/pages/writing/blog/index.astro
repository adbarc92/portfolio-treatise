---
import { getCollection } from "astro:content";

import Writing from "../../../layouts/Writing.astro";
import BlogList from "../../../components/BlogList";
import { formatDate } from "../../../lib/dates.mjs";
import { isPublished } from "../../../lib/drafts.mjs";

const DESCRIPTION =
  "Essays on software, fiction, and whatever else holds still long enough.";

const showDrafts = import.meta.env.DEV;

// Dates are formatted here rather than in the island: the formatter must run in
// UTC to print the authored day, and doing it server-side keeps that guarantee
// out of the browser's hands — and the formatter out of the bundle.
const posts = (await getCollection("blog", ({ data }) => isPublished(data, showDrafts)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    excerpt: post.data.excerpt,
    category: post.data.category,
    tags: post.data.tags,
    dateLabel: formatDate(post.data.date),
    dateTime: post.data.date.toISOString(),
    draft: post.data.draft,
  }));
---

<Writing title="Essays" description={DESCRIPTION}>
  <div class="page">
    <h1 class="page__title">Essays</h1>

    {
      posts.length === 0 ? (
        <p class="empty">Nothing here yet.</p>
      ) : (
        /* client:load, not client:idle — the chips are the first thing a reader
           reaches for on this page, and an unresponsive control is worse than a
           slightly earlier one. The island server-renders, so the full list is in
           the HTML either way. */
        <BlogList client:load posts={posts} showDrafts={showDrafts} />
      )
    }
  </div>
</Writing>
