---
// The Illuminated Treatise — single page, rendered entirely from claims.yaml
// and the extracted plate JSON. Visual truth: treatise-reference.html.
import { getCollection } from "astro:content";

import { claims } from "../lib/claims";
import HalyardPlate from "../components/HalyardPlate.astro";
import ContentsNav from "../components/ContentsNav.astro";
import { formatDate } from "../lib/dates.mjs";
import { isPublished } from "../lib/drafts.mjs";
import "../styles/treatise.css";

const { meta, sections, projects, workshop, author } = claims;

// typographic dressing on the confirmed thesis text (words stay claims.yaml's)
const thesisHtml = meta.thesis
  .replace("I work", "I&nbsp;work")
  .replace(/\bsecond\b/, "<em>second</em>");

// global noteref numbering: project claims in order, then workshop planned plates
const refNums = new Map<string, number>();
let refCount = 0;
for (const p of projects) for (const c of p.claims) refNums.set(`${p.id}:${c.id}`, ++refCount);
const workshopRefs = new Map<string, number>();
for (const m of workshop.prose.matchAll(/\[\^([\w-]+)\]/g)) workshopRefs.set(m[1]!, ++refCount);

type Seg = { text: string } | { ref: number };
function segments(prose: string, scope: (id: string) => number | undefined): Seg[] {
  const out: Seg[] = [];
  let last = 0;
  for (const m of prose.matchAll(/\[\^([\w-]+)\]/g)) {
    out.push({ text: prose.slice(last, m.index) });
    const num = scope(m[1]!);
    if (num === undefined) throw new Error(`claims gate: unresolvable noteref ${m[0]} — build fails`);
    out.push({ ref: num });
    last = m.index! + m[0].length;
  }
  out.push({ text: prose.slice(last) });
  return out;
}

const entrySegs = (p: (typeof projects)[number]) => {
  const prose =
    p.prose.trimEnd() +
    (p.not_yet.length > 0
      ? ` What it does not yet do is also worth saying: ${p.not_yet.join("; ")}.`
      : "");
  return segments(prose, (id) => refNums.get(`${p.id}:${id}`));
};
const workshopSegs = segments(workshop.prose.trimEnd(), (id) => workshopRefs.get(id));

const roman = (n: number) => ["", "I", "II", "III", "IV", "V", "VI", "VII"][n] ?? String(n);
const buildDate = new Date().toISOString().slice(0, 10);
const DRAFT_BADGE = "[DRAFT — AWAITING ALEX'S VOICE]";

// The treatise previews the essays; it does not hold a list of them. content/blog
// is the only source, so a draft cannot be advertised here while its own file
// withholds it — which is exactly how claims.yaml's copy had already drifted.
// Three is enough to show range without turning the treatise into an index.
//
// With none published the whole section (and its nav entry) hides and the
// remaining sections renumber.
const previewEssays = (await getCollection("blog", ({ data }) => isPublished(data, false)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const sectionList = [
  { id: "thesis", label: "Thesis" },
  { id: "plates", label: "Plates" },
  ...(previewEssays.length > 0 ? [{ id: "essays", label: "Essays" }] : []),
  { id: "workshop", label: "The Workshop" },
  { id: "author", label: "The Author" },
];
const secNum: Record<string, string> = Object.fromEntries(
  sectionList.map((s, i) => [s.id, roman(i + 1)]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alex Barclay — A Treatise on Trustworthy Autonomous Systems</title>
    <meta name="description" content="Alex Barclay — a treatise on trustworthy autonomous systems." />
    <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-opsz-italic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <ContentsNav onRoot />

      <header class="front" id="thesis">
        <p class="epigraph">
          “{meta.epigraph.text}”
          <cite>— {meta.epigraph.cite}</cite>
        </p>
        <h1 class="thesis" set:html={thesisHtml} />
        <p class="byline smallcaps">
          {meta.byline.name}<span class="dot">·</span>{meta.byline.place}<span class="dot">·</span>{meta.byline.role}
        </p>
      </header>

      <section id="plates">
        <p class="section-label smallcaps"><span class="num">{secNum.plates}</span>Plates</p>

        <div class="body-grid">
          <div class="prose">
            {sections.plates_intro.draft && <p class="draft-badge">{DRAFT_BADGE}</p>}
            <p>{sections.plates_intro.prose.trimEnd()}</p>
          </div>
          <aside class="margin-note">
            <span class="cite-mark">↳</span> figures derived from<br />repository definitions;<br />see
            <a href="#colophon">colophon</a> for method
          </aside>
        </div>

        <HalyardPlate />

        {projects.map((p, i) => (
          <article class="entry" id={p.id}>
            <div class="entry-head">
              <h3>{p.name}</h3>
              <span class="entry-meta">{p.meta_line}</span>
            </div>
            <div class="body-grid">
              <div class="prose">
                {p.draft && <p class="draft-badge">{DRAFT_BADGE}</p>}
                <p>
                  {entrySegs(p).map((s) =>
                    "ref" in s ? <sup class="noteref">{s.ref}</sup> : <Fragment>{s.text}</Fragment>
                  )}
                </p>
              </div>
              <aside class="margin-note">
                {p.claims.map((c) => (
                  <Fragment>
                    <span class="cite-mark">↳ {refNums.get(`${p.id}:${c.id}`)}</span> {c.text} —<br />
                    {c.verified && (
                      <Fragment>
                        <span class="verified">✓ verified</span> —<br />
                      </Fragment>
                    )}
                    <a href={c.evidence.url}>{c.evidence.label}</a>
                    <br />
                    <br />
                  </Fragment>
                ))}
                {p.plate.status !== "derived" && (
                  <Fragment>
                    <span class="faint">PLATE {roman(p.plate.number)} · {p.plate.status}</span>
                    <br />
                    <br />
                  </Fragment>
                )}
                {i === 0 && (
                  <span class="faint">[links resolve from<br />claims.yaml at build;<br />an orphan claim<br />fails the build]</span>
                )}
              </aside>
            </div>
          </article>
        ))}
      </section>

      {previewEssays.length > 0 && (
        <section id="essays">
          <p class="section-label smallcaps"><span class="num">{secNum.essays}</span>Essays</p>
          <div class="body-grid">
            <div class="prose">
              {sections.essays_intro.draft && <p class="draft-badge">{DRAFT_BADGE}</p>}
              <p>{sections.essays_intro.prose.trimEnd()}</p>
            </div>
            {sections.essays_intro.margin && (
              <aside class="margin-note">
                <span class="cite-mark">↳</span> {sections.essays_intro.margin}
              </aside>
            )}
          </div>

          {previewEssays.map((essay) => (
            <div class="essay">
              <div class="body-grid">
                <div class="prose">
                  <h3><a href={`/writing/${essay.id}`}>{essay.data.title}</a></h3>
                  <p class="abstract">{essay.data.excerpt}</p>
                </div>
                {/* Editorial matter, not a verified claim: no --verify cite-mark. */}
                <aside class="margin-note">
                  <time datetime={essay.data.date.toISOString()}>{formatDate(essay.data.date)}</time>
                </aside>
              </div>
            </div>
          ))}

          <p class="smallcaps all-writing"><a href="/writing/">All writing &rarr;</a></p>
        </section>
      )}

      <section id="workshop">
        <p class="section-label smallcaps"><span class="num">{secNum.workshop}</span>The Workshop</p>
        <div class="body-grid">
          <div class="prose">
            {workshop.draft && <p class="draft-badge">{DRAFT_BADGE}</p>}
            <p>
              {workshopSegs.map((s) =>
                "ref" in s ? <sup class="noteref">{s.ref}</sup> : <Fragment>{s.text}</Fragment>
              )}
            </p>
          </div>
          <aside class="margin-note">
            {workshop.planned_plates.map((pp) => (
              <Fragment>
                <span class="cite-mark">↳ {workshopRefs.get(pp.name.toLowerCase())}</span> {pp.name} —<br />
                PLATE {roman(pp.number)} · {pp.status}
                <br />
                <br />
              </Fragment>
            ))}
            <span class="faint">{workshop.disciplines}</span>
          </aside>
        </div>
      </section>

      <section id="author">
        <p class="section-label smallcaps"><span class="num">{secNum.author}</span>The Author</p>
        <div class="body-grid">
          <div class="prose">
            {author.draft && <p class="draft-badge">{DRAFT_BADGE}</p>}
            <p>{author.prose.trimEnd()}</p>
          </div>
          <aside class="margin-note">
            <span class="cite-mark">↳</span> correspondence:<br />
            <a href={`mailto:${meta.correspondence.email}`}>email</a> ·
            <a href={meta.correspondence.github}>github</a>
            {meta.correspondence.calendar && (
              <Fragment>
                 · <a href={meta.correspondence.calendar}>calendar</a>
              </Fragment>
            )}
          </aside>
        </div>
      </section>

      <footer class="colophon" id="colophon">
        <div class="device" aria-hidden="true">✳</div>
        <p class="smallcaps" style="color:var(--bone)">Colophon</p>
        <p>
          Set in Newsreader and JetBrains Mono, self-hosted. The figures are drawn from the repositories
          they describe, extracted by script and laid out by hand; a figure that stops matching its
          repository stops the build. A claim without evidence does the same — the margin notes are
          generated from one claims file, and the build refuses what it cannot cite. Nothing ships without
          a scan of the built output. Links are not yet checked.
        </p>
        <p class="mono" style="font-size:0.7rem">
          LAST VERIFIED: {buildDate} · GATES: CLAIMS ✓ · CONTENT ✓ · LINKS: PENDING
        </p>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var plates = document.querySelectorAll(".plate-frame.will-draw");
        if (!("IntersectionObserver" in window)) {
          plates.forEach(function (p) { p.classList.add("drawn"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add("drawn"); io.unobserve(e.target); }
            });
          },
          { threshold: 0.35 }
        );
        plates.forEach(function (p) { io.observe(p); });
      })();
    </script>
  </body>
</html>
