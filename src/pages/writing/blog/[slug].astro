---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

import Writing from "../../../layouts/Writing.astro";
import { formatDate } from "../../../lib/dates.mjs";
import { isPublished } from "../../../lib/drafts.mjs";

export const getStaticPaths: GetStaticPaths = async () => {
  // Drafts are emitted by the dev server and never by a build, so a build cannot
  // publish an unfinished essay even by way of a direct link.
  const posts = await getCollection("blog", ({ data }) =>
    isPublished(data, import.meta.env.DEV),
  );

  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<Writing title={post.data.title} description={post.data.excerpt}>
  <div class="page">
    <a class="back-link" href="/writing/blog">&larr; Back to Blog</a>

    {import.meta.env.DEV && post.data.draft && <span class="draft-badge">DRAFT</span>}

    <time class="meta date" datetime={post.data.date.toISOString()}>
      {formatDate(post.data.date)}
    </time>

    <h1>{post.data.title}</h1>

    {
      post.data.tags.length > 0 && (
        <div class="tags post__tags">
          {post.data.tags.map((tag) => (
            /* The tag lands as a query param the phase-4 filter island reads. */
            <a class="tag" href={`/writing/blog?tag=${encodeURIComponent(tag)}`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }

    <article class="prose">
      <Content />
    </article>
  </div>
</Writing>

<style>
  .date {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .post__tags {
    margin-bottom: 2rem;
  }
</style>
